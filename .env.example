# Copy to .env and change. Every value below is the development default used when it is left out.
# docker compose reads this file; it is never copied into the image.

# dev allows any CORS origin; production refuses to start with the default SECRET_KEY
ENVIRONMENT=dev

# Signs login tokens. In production use a long random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev-secret-key-change-in-production

# The database container's credentials. Change the password before exposing the database anywhere.
POSTGRES_USER=pafare
POSTGRES_PASSWORD=pafare
POSTGRES_DB=pafare

# Ports on your machine
API_PORT=8000
DB_PORT=5432

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Used for CORS when ENVIRONMENT is not dev
FRONTEND_URL=http://localhost:5173
